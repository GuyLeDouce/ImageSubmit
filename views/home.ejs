<%- include("partials/header") %>

<%
  const examples = Array.isArray(approvedExamples) ? approvedExamples : [];
  const heroSlides = examples.slice(0, 6);
  const featured = heroSlides[0] || null;
  const additionalExamples = examples.slice(1, 5);
  const eraLabels = Object.fromEntries(eras.map((era) => [era.key, era.label]));
%>

<section class="landing-hero" aria-labelledby="factory-title" data-reveal>
  <div class="landing-hero__copy">
    <p class="eyebrow">Welcome to the Squig Survival Image Factory</p>
    <h1 id="factory-title"><span>MAKE IT.</span><span class="hero-ugly">UGLY.</span></h1>
    <p class="hero-punchline">Got a Squig? Bring it to life.</p>
    <p class="lead">
      Draw it, generate it, remix it — create your way! Pick a Survival world, share
      your scene, and earn 100 $CHARM if your artwork gets approved.
    </p>
    <div class="landing-actions">
      <% if (!user) { %>
        <a class="button" href="/auth/discord">Start creating <span aria-hidden="true">&rarr;</span></a>
      <% } else if (user.isGuildMember) { %>
        <a class="button" href="/submit">Enter the Image Factory <span aria-hidden="true">&rarr;</span></a>
      <% } else { %>
        <a class="button" href="<%= links.discord %>" target="_blank" rel="noreferrer">Join Ugly Labs Discord <span aria-hidden="true">&rarr;</span></a>
      <% } %>
      <a class="text-cta" href="#eras">Explore the eras <span aria-hidden="true">&darr;</span></a>
    </div>
    <p class="hero-footnote">Your Squig. Your imagination. Stay Ugly.</p>
  </div>

  <aside class="landing-hero__visual" aria-label="Featured community creator artwork">
    <div class="feature-art" data-feature-gallery>
      <div class="feature-art__top">
        <span class="feature-art__signal" aria-hidden="true"></span>
        <strong>MADE BY THE COMMUNITY</strong>
        <span class="feature-art__edition" data-feature-counter><%= heroSlides.length ? '01 / ' + String(heroSlides.length).padStart(2, '0') : 'YOUR TURN NEXT' %></span>
      </div>
      <% if (featured) { %>
        <a class="feature-art__image" data-feature-link href="<%= featured.image_url %>" target="_blank" rel="noreferrer" aria-label="View featured creator artwork at full size">
          <img data-feature-image src="<%= featured.image_url %>" alt="Featured approved Squig Survival creator scene" />
        </a>
        <div class="feature-art__caption">
          <strong data-feature-caption><%= featured.milestone_label || featured.milestone_district || eraLabels[featured.era_key] || "Squig Survival" %></strong>
          <span>Approved creator artwork</span>
        </div>
        <% if (heroSlides.length > 1) { %>
          <div class="feature-art__picker" aria-label="Explore approved community creations">
            <div class="feature-art__thumbs" aria-label="Choose a featured creation">
              <% heroSlides.forEach((example, index) => { const slideTitle = example.milestone_label || example.milestone_district || eraLabels[example.era_key] || "Squig Survival"; %>
                <a
                  class="feature-art__thumb"
                  href="<%= example.image_url %>"
                  target="_blank"
                  rel="noreferrer"
                  data-feature-pick
                  data-feature-src="<%= example.image_url %>"
                  data-feature-title="<%= slideTitle %>"
                  data-feature-index="<%= index %>"
                  aria-label="Show creator artwork <%= index + 1 %>: <%= slideTitle %>"
                  aria-current="<%= index === 0 ? 'true' : 'false' %>"
                >
                  <img src="<%= example.image_url %>" alt="" loading="lazy" />
                </a>
              <% }) %>
            </div>
            <div class="feature-art__arrows" aria-label="Featured image controls">
              <button class="feature-art__arrow" type="button" data-feature-prev aria-label="Previous artwork">&larr;</button>
              <button class="feature-art__arrow" type="button" data-feature-next aria-label="Next artwork">&rarr;</button>
              <button class="feature-art__arrow feature-art__pause" type="button" data-feature-pause aria-label="Pause rotating artwork" aria-pressed="false" title="Pause slideshow">&#10074;&#10074;</button>
            </div>
          </div>
        <% } %>
      <% } else { %>
        <div class="feature-art__empty">
          <img src="/squigs-reloaded-logo.png" alt="" />
          <strong>Your Squig belongs here.</strong>
          <span>Approved community artwork will appear in this spot.</span>
        </div>
      <% } %>
    </div>
    <p class="feature-art__aside">Built by Squig holders. Made for Squig Survival.</p>
  </aside>
</section>

<section class="creator-section" id="eras" aria-labelledby="eras-heading" data-reveal>
  <div class="section-heading era-section-heading">
    <div>
      <p class="eyebrow"><%= eras.length %> open <%= eras.length === 1 ? "era" : "eras" %> / Endless possibilities</p>
      <h2 id="eras-heading">Choose your next adventure.</h2>
    </div>
    <p>Two worlds to explore. Endless ways to put your Squig in the story.</p>
  </div>
  <% if (!eras.length) { %>
    <div class="panel"><p>New submission windows are coming soon.</p></div>
  <% } else { %>
    <div class="era-grid">
      <% eras.forEach((era) => {
        const isRace = era.key === "death_race";
        const isCity = era.key === "ugly_city";
        const eraExample = examples.find((example) => example !== featured && !additionalExamples.includes(example) && example.era_key === era.key)
          || examples.find((example) => example !== featured && example.era_key === era.key)
          || examples.find((example) => example.era_key === era.key);
        // Exact, user-selected art for each world. Community submissions remain in the showcase.
        const officialEraImage = isRace
          ? "https://i.imgur.com/amVLHM9.png"
          : isCity ? "https://i.imgur.com/HHV8GmI.png" : null;
        const tagline = isRace
          ? "An armored death race. One finish line. Anything goes."
          : isCity
            ? "Build the city, survive the milestones, create the story."
            : era.description;
      %>
        <a
          class="era-card <%= isRace ? 'era-card--race' : isCity ? 'era-card--city' : '' %>"
          data-era-world="<%= era.key %>"
          href="/submit?era=<%= encodeURIComponent(era.key) %>"
          <%- isRace ? 'id="squigwreck"' : '' %>
        >
          <div class="era-card__body">
            <span class="era-card__eyebrow"><%= isRace ? "ERA 02 / DEATH RACE" : isCity ? "ERA 01 / UGLY CITY" : "SURVIVAL ERA" %></span>
            <div class="era-card__description">
              <h3><%= era.label %></h3>
              <p><%= tagline %></p>
            </div>
            <span class="era-card__link">Let's create <span aria-hidden="true">&nearr;</span></span>
          </div>
          <div class="era-card__visual">
            <% if (officialEraImage) { %>
              <img
                src="<%= officialEraImage %>"
                data-official-era-image
                data-fallback-src="<%= eraExample?.image_url || '' %>"
                data-era-label="<%= era.label %>"
                alt="<%= era.label %> official era illustration"
                loading="lazy"
                decoding="async"
                referrerpolicy="no-referrer"
              />
            <% } else if (eraExample) { %>
              <img src="<%= eraExample.image_url %>" alt="<%= era.label %> era illustration" loading="lazy" />
            <% } else { %>
              <span class="era-card__art-title" aria-hidden="true"><%= isRace ? "SQUIGWRECK" : isCity ? "UGLY CITY" : era.label %></span>
            <% } %>
          </div>
        </a>
      <% }) %>
    </div>
  <% } %>
</section>

<% if (additionalExamples.length) { %>
  <section class="creator-wall creator-section" aria-labelledby="creator-wall-title" data-reveal>
    <div class="section-heading creator-wall__heading">
      <div>
        <p class="eyebrow">Straight out of the Image Factory</p>
        <h2 id="creator-wall-title">Look what our creators made.</h2>
      </div>
      <span class="creator-wall__meta">Real submissions. Real Squigs.</span>
    </div>
    <div class="creator-wall__grid">
      <% additionalExamples.forEach((example) => { %>
        <figure class="creator-wall__item">
          <a href="<%= example.image_url %>" target="_blank" rel="noreferrer" data-artwork-view aria-label="Open this approved creator image">
            <img src="<%= example.image_url %>" alt="Approved Squig Survival creator scene" loading="lazy" />
          </a>
          <figcaption><%= example.milestone_label || example.milestone_district || eraLabels[example.era_key] || "Squig Survival" %></figcaption>
        </figure>
      <% }) %>
    </div>
  </section>
<% } %>

<section class="how-rail" id="how-it-works" aria-labelledby="how-heading" data-reveal>
  <div class="how-rail__intro">
    <p class="eyebrow">It's that simple</p>
    <h2 id="how-heading">Your art. Their survival.</h2>
    <p>Any creative tool. All you need is a Squig and an idea.</p>
    <a href="/submit?era=death_race" class="text-cta">Need ideas? Grab a Squigwreck prompt <span aria-hidden="true">&rarr;</span></a>
  </div>
  <div class="how-rail__steps">
    <div><span>01</span><strong>Pick your era</strong><small>Find the world your Squig belongs in.</small></div>
    <div><span>02</span><strong>Make your scene</strong><small>Draw it, generate it or get creative.</small></div>
    <div><span>03</span><strong>Submit and earn</strong><small>Approved images get 100 $CHARM.</small></div>
  </div>
  <details class="rules-disclosure" id="rules">
    <summary>What makes an image eligible? <span>Read the creator rules</span></summary>
    <ul class="rules-list-simple">
      <li>Every image must clearly include at least one recognizable Squig.</li>
      <li>Other NFTs, collections or memes are welcome as long as a Squig is present.</li>
      <li>Choose the correct era and a milestone when the era requires one.</li>
      <li>Images must be approved before they can enter the eligible game image pool.</li>
      <li>Approval does not guarantee in-game use. Eligible images are selected randomly under the existing Survival rules.</li>
    </ul>
  </details>
</section>

<%- include("partials/footer") %>
