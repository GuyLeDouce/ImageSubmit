<%- include("partials/header") %>

<%
  const eraLabel = selectedEra?.label || "Squig Survival";
  const eraLabels = Object.fromEntries(adminRepairEras.map((era) => [era.key, era.label]));
  const selectedMilestoneKey = selectedMilestone?.key || "";
  const conceptByMilestone = milestoneConcepts || {};
  const defaultMilestoneConcept = "Choose a milestone to see what kind of image fits that chapter.";
  const selectedMilestoneConcept = conceptByMilestone[selectedMilestoneKey] || defaultMilestoneConcept;
  const statusLabels = { pending: "Awaiting approval", approved: "Approved", declined: "Declined" };
  const submissionGroups = [
    { key: "pending", title: "Awaiting approval", emptyText: "Nothing in the review queue. Yet." },
    { key: "approved", title: "Approved creations", emptyText: "No approved images yet." },
    { key: "declined", title: "Declined submissions", emptyText: "No declined images." },
  ].map((group) => ({
    ...group,
    items: (submissions || []).filter((submission) => submission.status === group.key),
  }));
%>

<section class="stack-gap submit-page">
  <header class="dashboard-hero">
    <div>
      <p class="breadcrumb"><a href="/">Image Factory</a><span>/</span> Creator Studio</p>
      <p class="eyebrow">Make something ugly (in a good way)</p>
      <h1>Create for Survival.</h1>
      <p class="lead">Pick your world, make something great, and send it in. Images go straight to the team for review.</p>
    </div>
  </header>

  <% if (submitted) { %>
    <div class="success-box" role="status">
      Your artwork is in the review queue! You'll see the status below when the team reviews it.
    </div>
  <% } %>

  <section class="stage-section" aria-labelledby="choose-era-heading">
    <div class="stage-section__heading">
      <span class="stage-number" aria-hidden="true">01</span>
      <div>
        <h2 id="choose-era-heading">Choose your world.</h2>
        <p>Different eras, different stories. Where does yours belong?</p>
      </div>
    </div>
    <div class="era-choice-grid">
      <% eras.forEach((era) => { const isRace = era.key === "death_race"; const isSelected = selectedEra?.key === era.key; %>
        <a
          href="/submit?era=<%= encodeURIComponent(era.key) %>"
          class="era-choice <%= isRace ? 'era-choice--race' : '' %> <%= isSelected ? 'era-choice--active' : '' %>"
          <%- isSelected ? 'aria-current="page"' : '' %>
        >
          <span class="era-choice__mark" aria-hidden="true"><%= isRace ? "SW" : "SQ" %></span>
          <span><strong><%= era.label %></strong><small><%= isRace ? "Open race scenes" : "Survival scenes" %></small></span>
          <span class="era-choice__tick" aria-hidden="true"><%= isSelected ? "✓" : "→" %></span>
        </a>
      <% }) %>
    </div>
  </section>

  <% if (selectedEra && (!selectedEra.milestones.length || milestones.length)) { %>
    <div class="submit-layout submit-layout--single">
      <form action="/submit" method="post" enctype="multipart/form-data" class="panel form-panel" data-creator-form>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <input type="hidden" name="era_key" value="<%= selectedEra.key %>" />

        <header class="form-panel__header">
          <p class="eyebrow">Currently creating for</p>
          <h2><%= eraLabel %></h2>
          <p class="era-intro"><%= selectedEra.description %></p>
        </header>

        <% if (milestones.length) { %>
          <section class="stage-section">
            <div class="stage-section__heading">
              <span class="stage-number" aria-hidden="true">02</span>
              <div>
                <h2>Pick your chapter.</h2>
                <p>Choose the milestone your artwork is for.</p>
              </div>
            </div>
            <label class="field">
              <span>Survival milestone</span>
              <select name="milestone_key" required data-milestone-select aria-describedby="milestone-concept-note milestone-discord-note">
                <option value="">Choose a milestone</option>
                <% milestones.forEach((milestone) => { %>
                  <option
                    value="<%= milestone.key %>"
                    data-concept="<%= conceptByMilestone[milestone.key] || defaultMilestoneConcept %>"
                    <%= milestone.key === selectedMilestoneKey ? "selected" : "" %>
                  ><%= milestone.number %>. <%= milestone.district %></option>
                <% }) %>
              </select>
              <small class="field-note milestone-concept-note" id="milestone-concept-note" data-default-text="<%= defaultMilestoneConcept %>"><%= selectedMilestoneConcept %></small>
              <small class="field-note milestone-discord-note" id="milestone-discord-note">Watch Discord for future chapter submission windows.</small>
            </label>
          </section>
        <% } %>

        <% if (selectedEra.key === "death_race") { %>
          <section class="stage-section" id="prompt-library" aria-labelledby="prompts-heading">
            <div class="stage-section__heading">
              <span class="stage-number" aria-hidden="true">02</span>
              <div>
                <h2 id="prompts-heading">Find your inspiration.</h2>
                <p>Last racer alive wins. Pick one or two Squigs for 24 cinematic scenes packed with armoured racers, brutal near misses and dark cartoon humour. Copy a prompt and attach your original Squig artwork in your image generator.</p>
              </div>
            </div>
            <div class="prompt-type-choice" data-prompt-type-choice hidden role="group" aria-label="Squig references attached" aria-describedby="prompt-attachment-help">
              <% deathRacePromptGroups.forEach((group, index) => { %>
                <button type="button" class="prompt-type-button" data-prompt-type="<%= group.id %>" aria-pressed="<%= index === 0 ? 'true' : 'false' %>" aria-controls="prompt-panel-<%= group.id %>">
                  <span><strong><%= group.label %></strong><small><%= group.prompts.length %> battle-ready scenes</small></span>
                  <span class="prompt-type-button__check" aria-hidden="true">✓</span>
                </button>
              <% }) %>
            </div>
            <p class="field-note" id="prompt-attachment-help">Attach the reference images with your copied prompt in your image generator. Upload the finished artwork below.</p>
            <div id="squigwreck-prompt-groups" class="prompt-groups">
              <% deathRacePromptGroups.forEach((group) => { %>
                <section class="prompt-group" id="prompt-panel-<%= group.id %>" data-prompt-group="<%= group.id %>" aria-labelledby="prompt-group-<%= group.id %>">
                  <header class="prompt-group__heading">
                    <h3 id="prompt-group-<%= group.id %>"><%= group.label %> <small>· <%= group.prompts.length %> prompts</small></h3>
                    <p class="field-note"><%= group.instructions %></p>
                  </header>
                  <div class="prompt-library">
                    <% group.prompts.forEach((item, index) => { %>
                      <details class="prompt-card" id="<%= item.id %>">
                        <summary class="prompt-card__summary">
                          <span class="prompt-card__number" aria-hidden="true"><%= String(index + 1).padStart(2, "0") %></span>
                          <strong><%= item.title %></strong>
                          <small>View prompt</small>
                        </summary>
                        <div class="prompt-card__details">
                          <p>Use <%= group.squigCount === 1 ? "one original Squig reference" : "two original Squig references, in order" %>. Keep every Squig recognizable and the whole scene in the clean Squigs cartoon style.</p>
                          <textarea readonly rows="7" aria-label="<%= item.title %> prompt"><%= item.prompt %></textarea>
                          <button class="button secondary" type="button" data-copy-death-race-prompt>Copy full prompt</button>
                        </div>
                      </details>
                    <% }) %>
                  </div>
                </section>
              <% }) %>
            </div>
          </section>
        <% } %>

        <section class="stage-section" aria-labelledby="upload-heading">
          <div class="stage-section__heading">
            <span class="stage-number" aria-hidden="true"><%= selectedEra.key === "death_race" || milestones.length ? "03" : "02" %></span>
            <div>
              <h2 id="upload-heading">Upload your creation.</h2>
              <p>Time to show off what you made.</p>
            </div>
          </div>
          <div class="field">
            <label for="images-upload" class="field-label">Your images</label>
            <div class="upload-zone" data-upload-zone>
              <div class="upload-zone__label">
                <strong>Choose or drop your artwork here</strong>
                <span>PNG, JPG, WebP or GIF. Up to 10 images per submission.</span>
              </div>
              <input
                id="images-upload"
                type="file"
                name="images"
                accept="image/png,image/jpeg,image/webp,image/gif"
                multiple required
                data-upload-input
                aria-describedby="upload-help"
              />
              <p class="field-note" id="upload-help">Each image is reviewed on its own. A preview will appear here before you submit.</p>
            </div>
            <div class="upload-preview" data-upload-preview hidden aria-live="polite"></div>
          </div>
          <label class="checkbox-field">
            <input type="checkbox" name="contains_squig_confirmed" required />
            <span>Yep, my artwork includes at least one clearly visible Squig.</span>
          </label>
        </section>

        <section class="stage-section" aria-labelledby="details-heading">
          <div class="stage-section__heading">
            <span class="stage-number" aria-hidden="true"><%= selectedEra.key === "death_race" || milestones.length ? "04" : "03" %></span>
            <div>
              <h2 id="details-heading">The finishing touches.</h2>
              <p>A little extra context helps the team review your work. Both fields are optional.</p>
            </div>
          </div>
          <label class="field">
            <span>Other NFTs / collections in the image (optional)</span>
            <input
              type="text" name="other_collections_text" maxlength="500"
              placeholder="Other characters, collections, memes or sources"
            />
          </label>
          <label class="field">
            <span>Prompt used (optional)</span>
            <textarea
              name="prompt_text" rows="5" maxlength="4000"
              placeholder="Share your creative prompt, if you used one"
            ></textarea>
          </label>
        </section>

        <div class="form-finish">
          <p class="reward-note">✓ Approved images earn 100 $CHARM.</p>
          <button type="submit" class="button" data-submit-artwork>Submit artwork for review &rarr;</button>
        </div>
      </form>
    </div>
  <% } else { %>
    <div class="panel"><p>Submissions are currently closed for this era. Check Discord for the next opening.</p></div>
  <% } %>

  <section class="submission-history" aria-labelledby="history-heading">
    <div class="submission-history__header">
      <p class="eyebrow">Your work so far</p>
      <h2 id="history-heading">Your submitted images.</h2>
      <p class="muted">These creations are linked to <strong><%= user.username %></strong>. <a href="/profile">Open your full creator gallery</a>.</p>
    </div>

    <% submissionGroups.forEach((group) => { %>
      <section class="panel submission-group">
        <div class="submission-group__heading">
          <h3><%= group.title %></h3>
          <span class="submission-count"><%= group.items.length %></span>
        </div>
        <% if (!group.items.length) { %>
          <p class="muted empty-state"><%= group.emptyText %></p>
        <% } else { %>
          <div class="submission-grid">
            <% group.items.forEach((submission) => { %>
              <article class="submission-tile submission-tile--<%= submission.status %>">
                <a class="submission-tile__media" href="<%= submission.image_url %>" target="_blank" rel="noreferrer" data-artwork-view aria-label="Open submitted image">
                  <img src="<%= submission.image_url %>" alt="Submitted creator image <%= submission.id %>" loading="lazy" />
                </a>
                <div class="submission-tile__body">
                  <div class="submission-tile__topline">
                    <span class="submission-status submission-status--<%= submission.status %>"><%= statusLabels[submission.status] %></span>
                    <time class="submission-tile__date" datetime="<%= new Date(submission.submitted_at).toISOString() %>">
                      <%= new Date(submission.submitted_at).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }) %>
                    </time>
                  </div>
                  <strong class="submission-tile__summary"><%= submission.milestone_label || eraLabels[submission.era_key] || submission.era_key %></strong>
                  <details class="submission-tile__details">
                    <summary>View details</summary>
                    <dl class="submission-tile__meta">
                      <div><dt>Era</dt><dd><%= eraLabels[submission.era_key] || submission.era_key %></dd></div>
                      <% if (submission.milestone_label || submission.milestone_key) { %>
                        <div><dt>Milestone</dt><dd><%= submission.milestone_label || submission.milestone_key %></dd></div>
                      <% } %>
                      <div><dt>Reward</dt><dd><%= submission.reward_points || 100 %> $CHARM</dd></div>
                      <% if (submission.other_collections_text || submission.nft_used_text) { %>
                        <div><dt>Other collections</dt><dd><%= submission.other_collections_text || submission.nft_used_text %></dd></div>
                      <% } %>
                      <% if (submission.status !== "pending") { %>
                        <div><dt>Reviewed</dt><dd><%= submission.reviewed_at ? new Date(submission.reviewed_at).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }) : "Not available" %></dd></div>
                      <% } %>
                      <% if (submission.status === "declined" && submission.decline_reason) { %>
                        <div class="decline-reason"><dt>Reason</dt><dd><%= submission.decline_reason %></dd></div>
                      <% } %>
                    </dl>
                    <% if (submission.prompt_text) { %>
                      <p class="submission-tile__prompt"><%= submission.prompt_text %></p>
                    <% } %>
                  </details>
                </div>
              </article>
            <% }) %>
          </div>
        <% } %>
      </section>
    <% }) %>
  </section>
</section>

<%- include("partials/footer") %>
